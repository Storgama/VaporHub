{
  "name": "vaporhub",
  "version": "1.0.0",
  "description": "Outil de gestion et suivi de contenu",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "dev:backend": "npm run dev --prefix Backend",
    "dev:frontend": "npm run dev --prefix Frontend",
    "dev": "concurrently -k -n \"BACK,FRONT\" -c \"magenta,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "test:backend": "npm run test --prefix Backend",
    "test:frontend": "npm run test --prefix Frontend",
    "test": "npm run test:backend && npm run test:frontend",
    "test:coverage": "npm run test:coverage --prefix Backend && npm run test:coverage --prefix Frontend"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Storgama/VaporHub.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/Storgama/VaporHub/issues"
  },
  "homepage": "https://github.com/Storgama/VaporHub#readme",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}