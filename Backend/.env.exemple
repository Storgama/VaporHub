NODE_ENV=#DEV OR PROD#

# Option 1 : Monolink (prioritaire)
DATABASE_URL = 

# Option 2 : Paramètres décomposés (utilisés si DATABASE_URL est absent ou vide)
# DB_HOST = localhost
# DB_PORT = 5432
# DB_USER = postgres
# DB_PASSWORD = 
# DB_NAME = vaporhub
# DB_SSL = false

FRONTEND_URL = http://localhost:5173

# Option Dev mail configurable pour seeding
SEED_USER_EMAIL=

# Contact pour le signalement de failles (Point 100 - RFC 9116)
SECURITY_CONTACT=mailto:

ENCRYPTION_KEY=ta_cle_generee_de_64_caracteres

TWITCH_CLIENT_ID =
TWITCH_CLIENT_SECRET =
TWITCH_REDIRECT_URI = http://localhost:3000/api/twitch/callback

YOUTUBE_CLIENT_ID =
YOUTUBE_CLIENT_SECRET =
YOUTUBE_REDIRECT_URI = http://localhost:3000/api/youtube/callback

# Authentification JWT
JWT_ACCESS_SECRET= your_jwt_access_secret_here_min_64_chars
JWT_REFRESH_SECRET= your_jwt_refresh_secret_here_min_64_chars
JWT_ACCESS_EXPIRES_IN= 15m
JWT_REFRESH_EXPIRES_IN= 7d